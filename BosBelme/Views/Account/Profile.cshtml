@{
    ViewData["Title"] = "Профиль";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account/profile.css">
}

<h1 class="large-text">Терминал Пользователя</h1>
<hr/>

<div class="info-card">
    <div class="avatar-container">
        @* <img src="~/img/user-avatar-pixel.png" alt="Avatar" style="width: 64px; height: 64px; image-rendering: pixelated;" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" /> *@
        <span style="font-size: 48px; display: none;">💾</span>
    </div>
    <div class="info-container">
        <div class="info-row">
            <span class="info-label">Пользователь:</span>
            <span class="info-value">@ViewBag.UserName</span>
        </div>
        <div class="info-row">
            <span class="info-label">Системный ID:</span>
            <span class="info-value">#@ViewBag.UserId</span>
        </div>
        <div class="info-row" id="long-email">
            <span class="info-label">Почта:</span>
            <span class="info-value">@ViewBag.Email</span>
        </div>
        <div class="info-row">
            <span class="info-label">Статус доступа:</span>
            <div class="status-container">
                <span class="status-badge">USER</span>
            </div>
        </div>
    </div>
</div>

<div style="margin-top: 30px; display: flex; gap: 15px;" class="btn-container">
    <a asp-controller="Hub" asp-action="Index" class="btn">
        [._.] В игровой хаб
    </a>
    <a asp-controller="Home" asp-action="Index" class="btn">
        [*] На главную
    </a>
    <a class="small-link" asp-controller="Account" asp-action="Logout">
        Выйти из профиля
    </a>
</div>
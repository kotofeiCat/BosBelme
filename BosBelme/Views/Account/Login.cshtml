@{
    ViewData["Title"] = "Авторизация";
}

<h2 class="first-text">Вход в систему</h2>
<div class="line"></div>

<div asp-validation-summary="ModelOnly" class="form-link" style="color: red; margin-bottom: 15px;"></div>

<form asp-controller="Account" asp-action="Login" method="post" class="retro-form">
    <div class="input-group">
        <input name="NameOrEmail" class="retro-input" id="email" type="text" placeholder="Имя или Почта" required>
    </div>

    <div class="input-group">
        <input name="Password" class="retro-input" id="password" type="password" placeholder="Пароль" maxlength="100" required>
    </div>

    <div class="form-footer">
        <button class="retro-btn" type="submit">Войти</button>
        <a class="form-link" asp-controller="Account" asp-action="Register">Нет аккаунта?</a>
    </div>
</form>
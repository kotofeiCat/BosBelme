@model BosBelme.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Авторизация";
}

<h2 class="large-text">Вход в систему</h2>
<hr/>

<div asp-validation-summary="ModelOnly" class="small-link" style="color: red; margin-bottom: 15px;"></div>

<form asp-controller="Account" asp-action="Login" method="post">
    <div class="input-group">
        <label for="NameOrEmail">Имя пользователя или Email:</label>
        <input asp-for="NameOrEmail" placeholder="Введите логин..." required>
    </div>

    <div class="input-group">
        <label for="Password">Пароль:</label>
        <input asp-for="Password" placeholder="••••••••" required>
    </div>

    <div class="btn-container">
        <button class="btn" type="submit">
            [>] Войти
        </button>
        <a class="small-link" asp-controller="Account" asp-action="Register">Нет аккаунта?</a>
    </div>
</form>
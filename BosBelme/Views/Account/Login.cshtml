<p class="first-text dark-color">Авторизация</p>

<hr class="line">

<form action="" method="post">
    <label for="email"></label>
    <input name="NameOrEmail" class="input container" id="email" type="email" placeholder="Имя или Почта" required>

    <label for="password"></label>
    <input name="Password" class="input container" id="password" type="password" placeholder="Пароль" maxlength="100" required>

    <div class="row-container">
        <button class="send" type="submit">Войти</button>

        <p class="for-login"><a href="/Account/Register">Нет аккаунта?</a></p>
    </div>
    
</form>

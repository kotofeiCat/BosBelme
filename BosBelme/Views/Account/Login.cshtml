@model BosBelme.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Авторизация";
}

<h2 class="first-text">Вход в систему</h2>
<div class="line"></div>

<div asp-validation-summary="ModelOnly" class="form-link" style="color: red; margin-bottom: 15px;"></div>

<form asp-controller="Account" asp-action="Login" method="post" class="retro-form">
    <div class="input-group">
        <label for="NameOrEmail">Имя пользователя или Email:</label>
        <input asp-for="NameOrEmail" class="retro-input" placeholder="Введите логин..." required>
    </div>

    <div class="input-group">
        <label for="Password">Пароль:</label>
        <input asp-for="Password" class="retro-input" placeholder="••••••••" required>
    </div>

    <div class="form-footer">
        <button class="retro-btn btn-with-icon" type="submit">
            <span>[>] Войти</span>
        </button>
        <a class="form-link" asp-controller="Account" asp-action="Register">Нет аккаунта?</a>
    </div>
</form>
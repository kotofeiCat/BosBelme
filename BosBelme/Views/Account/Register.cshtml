@{
    ViewData["Title"] = "Регистрация";
}

<h2 class="first-text">Регистрация нового пользователя</h2>
<div class="line"></div>

<div asp-validation-summary="ModelOnly" class="form-link" style="color: red; margin-bottom: 15px;"></div>

<form asp-controller="Account" asp-action="Register" method="post" class="retro-form">
    <div class="input-group">
        <input name="Name" class="retro-input" id="name" type="text" placeholder="Имя пользователя" maxlength="20" required>
    </div>

    <div class="input-group">
        <input name="Email" class="retro-input" id="email" type="email" placeholder="Эл. почта (Email)" required>
    </div>

    <div class="input-group">
        <input name="Password" class="retro-input" id="password" type="password" placeholder="Пароль" maxlength="100" required>
    </div>

    <div class="input-group">
        <input name="ConfirmPassword" class="retro-input" id="confirm-password" type="password" placeholder="Подтвердите пароль" maxlength="100" required>
    </div>

    <div class="form-footer">
        <button class="retro-btn" type="submit">Создать</button>
        <a class="form-link" asp-controller="Account" asp-action="Login">Уже есть аккаунт?</a>
    </div>
</form>
<p class="first-text dark-color">Регистрация</p>

<hr class="line">

<form action="" method="post">
    <label for="name"></label>
    <input name="Name" class="input container" id="name" type="text" placeholder="Имя" maxlength="20" required>

    <label for="email"></label>
    <input name="Email" class="input container" id="email" type="email" placeholder="Почта" required>

    <label for="password"></label>
    <input name="Password" class="input container" id="password" type="password" placeholder="Пароль" maxlength="100" required>
    
    <label for="confirm-password"></label>
    <input name="ConfirmPassword" class="input container" id="confirm-password" type="password" placeholder="Повторите" maxlength="100" required>

    <div class="row-container">
        <button class="send" type="submit">Отправить</button>

        <p class="for-login"><a href="/Account/Login">Уже есть аккаунт?</a></p>
    </div>
    
</form>
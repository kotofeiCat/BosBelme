@model BosBelme.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}

@section Scripts {
    <script>
        document.querySelector('.window')?.classList.add('window-auth');
    </script>
}

<div class="auth-card">
    <div class="auth-header-icon" style="border-color: var(--color-orange); color: var(--color-orange);">
        <i class="fa-solid fa-user-plus"></i>
    </div>

    <h2 class="auth-title">Регистрация</h2>
    <p class="auth-subtitle">Создайте новый аккаунт в системе RoomBox</p>

    <form asp-controller="Account" asp-action="Register" method="post" style="width: 100%;">
        <div class="input-group">
            <input asp-for="Name" class="input" required placeholder=" " autocomplete="off" />
            <label class="user-label" asp-for="Name">Имя пользователя</label>
        </div>

        <div class="input-group">
            <input asp-for="Email" type="email" class="input" required placeholder=" " autocomplete="off" />
            <label class="user-label" asp-for="Email">Email адрес</label>
        </div>

        <div class="input-group">
            <input asp-for="Password" type="password" class="input" required placeholder=" " />
            <label class="user-label" asp-for="Password">Пароль</label>
        </div>

        <div class="input-group">
            <input asp-for="ConfirmPassword" type="password" class="input" required placeholder=" " />
            <label class="user-label" asp-for="ConfirmPassword">Повторите пароль</label>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 10px;">
            <button class="button-name btn-orange" type="submit" style="width: 100%;">
                <span>Зарегистрироваться</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>
            <a class="small-link" asp-controller="Account" asp-action="Login" style="text-align: center; font-size: 12px; color: var(--color-cyan); text-decoration: none;">Уже есть аккаунт? Войти</a>
        </div>
    </form>
</div>
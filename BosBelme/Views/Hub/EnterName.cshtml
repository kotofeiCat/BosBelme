@model BosBelme.ViewModels.EnterNameViewModel

@{
    // Меняем заголовок в зависимости от того, входим мы или создаем
    bool isJoining = !string.IsNullOrEmpty(Model.RoomCode);
    ViewData["Title"] = isJoining ? "Вход в комнату" : "Создание комнаты";
}

<h2 class="large-text">@ViewData["Title"]</h2>
<hr />

<p class="other-text">
    @(isJoining
        ? $"Вы подключаетесь к комнате {Model.RoomCode}. Пожалуйста, введите ваше временное имя."
        : "Введите ваше имя в системе для инициализации выделенного пространства.")
</p>

<form asp-controller="Hub" asp-action="EnterName" method="post">
    <div asp-validation-summary="ModelOnly" style="color: red; font-family: monospace; margin-bottom: 10px;"></div>

    <input type="hidden" asp-for="RoomCode" />

    <div class="input-group">
        <label asp-for="PlayerName">Ваш Игровой Никнейм:</label>
        <input asp-for="PlayerName" placeholder="User_777" autocomplete="off" required />
        <span asp-validation-for="PlayerName" style="color: red; font-family: monospace; font-size: 11px; margin-top: 5px;"></span>
    </div>

    <div class="btn-container">
        <button class="btn" type="submit">
            @if (isJoining)
            {
                <text>[->] Войти</text>
            }
            else
            {

                <text>[+] Создать</text>
            }
        </button>
        <a class="small-link" asp-controller="Hub" asp-action="Index">Назад в Хаб</a>
    </div>
</form>
@model BosBelme.ViewModels.EnterNameViewModel
@{
    bool isJoining = !string.IsNullOrEmpty(Model.RoomCode);
    ViewData["Title"] = isJoining ? "Подключение" : "Создание игрока";
}

@section Scripts {
    <script>
        document.querySelector('.window')?.classList.add('window-auth');
    </script>
}

<div class="auth-card">
    <div class="auth-header-icon">
        <i class="fa-solid fa-user-astronaut"></i>
    </div>

    <h2 class="auth-title">@ViewData["Title"]</h2>
    <p class="auth-subtitle">
        @(isJoining
            ? $"Подключение к сессии {Model.RoomCode}. Укажите никнейм:"
            : "Укажите отображаемое имя для входа:")
    </p>

    <form asp-controller="Hub" asp-action="EnterName" method="post" style="width: 100%;">
        <input type="hidden" asp-for="RoomCode" />

        <div class="input-group">
            <input asp-for="PlayerName" class="input" required placeholder=" " autocomplete="off" />
            <label class="user-label" asp-for="PlayerName">Ваше Имя / Никнейм</label>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
            <button class="button-name btn-orange" type="submit" style="width: 100%;">
                <span>Продолжить</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>

            <a class="button-name btn-ghost" asp-controller="Hub" asp-action="Index" style="width: 100%;">
                <span>Отмена</span>
            </a>
        </div>
    </form>
</div>
@using System.Security.Claims
@model BosBelme.ViewModels.RoomViewModel
@{
    var currentUserName = User.FindFirstValue(ClaimTypes.Name);
    bool isAmIHost = Model.HostName == currentUserName;
    ViewData["Title"] = $"Комната {Model.RoomName}";
}

<div class="room-os-container">

    <!-- Заголовок комнаты -->
    <div class="room-header-block">
        <h1 class="large-text room-main-title">@Model.RoomName</h1>
        <hr class="retro-hr" />
    </div>

    <!-- Карточка информации о комнате -->
    <div class="info-card retro-card">

        <!-- Иконка дискеты -->
        <div class="avatar-container floppy-icon-box">
            <span class="floppy-emoji">💾</span>
        </div>

        <!-- Контейнер с данными -->
        <div class="info-container retro-spec-list">

            <!-- Код подключения -->
            <div class="info-row align-center wrap-gap">
                <span class="info-label">Код подключения:</span>
                <div class="copy-crypto-box" onclick="copyTextToClipboard('@Model.RoomCode', this, 'code')" title="Кликните для копирования">
                    <span id="display-room-code">@Model.RoomCode</span>
                    <span id="code-icon">📋</span>
                </div>
            </div>

            <!-- Создатель комнаты -->
            <div class="info-row">
                <span class="info-label">Создатель (Host):</span>
                <span class="info-value host-name-badge">@Model.HostName</span>
            </div>

            <!-- Статус Ядра -->
            <div class="info-row align-center">
                <span class="info-label">Статус Ядра:</span>
                <div class="status-container">
                    <span class="status-badge core-status">@Model.Status</span>
                </div>
            </div>

            <!-- Выбор игры -->
            <div class="info-row align-center gap-10 m-top-4">
                <span class="info-label">Выбранное ПО:</span>
                @if (isAmIHost)
                {
                    <select id="game-selector" class="retro-select">
                        @foreach (var game in Model.AvailableGames)
                        {
                            <option value="@game.Id" selected="@(game.Id == Model.GameId ? "selected" : null)">@game.Name</option>
                        }
                    </select>
                }
                else
                {
                    <span id="current-game-name" class="retro-read-only-value">@Model.GameName</span>
                }
            </div>

            <!-- Лимиты игроков -->
            <div class="info-row m-top-4">
                <span class="info-label">Лимиты терминалов:</span>
                <span class="info-value terminal-limits">
                    [ MIN: <span id="min-players" class="color-blue">@Model.MinPlayers</span> ]
                    [ MAX: <span id="max-players" class="color-red">@Model.MaxPlayers</span> ]
                </span>
            </div>

        </div>
    </div>

    <!-- Список игроков -->
    <div class="terminals-section">
        <h2 class="large-text terminal-section-title">
            ПОДКЛЮЧЕННЫЕ ТЕРМИНАЛЫ (<span id="player-count">@Model.Players.Count</span>)
        </h2>
        <ul id="player-list" class="retro-list-group">
            @foreach (var player in Model.Players)
            {
                var badgeColorClass = (player.IsReady || player.IsHost) ? "status-ready" : "status-not-ready";
                var statusText = player.IsHost ? "[HOST]" : (player.IsReady ? "[ГОТОВ]" : "[НЕ ГОТОВ]");

                <li class="retro-list-item">
                    <div class="player-info-side">
                        <span class="terminal-icon">🖥️</span>
                        <strong class="player-name-text">@player.Name</strong>
                        @if (player.IsGuest)
                        {
                            <span class="guest-tag">[GUEST]</span>
                        }
                    </div>
                    <div class="player-status-side">
                        <span class="ready-status-badge @badgeColorClass">@statusText</span>
                    </div>
                </li>
            }
        </ul>
    </div>

    <!-- СИСТЕМНЫЙ МОНИТОР -->
    <div class="monitor-section">
        <div class="monitor-header">
            <h2 class="large-text monitor-title">ROOMBOX OS V1.06 - SYSTEM LOG MONITOR:</h2>
            <span class="monitor-status-tag">[ONLINE]</span>
        </div>
        <div class="monitor-crt-screen">
            <div id="room-console">
                <div class="sys-log-muted">[SYSTEM] Инициализация протоколов шифрования... OK.</div>
                <div class="sys-log-accent">[SYSTEM] Терминал готов к приему пакетов данных.</div>
                <div id="console-prompt">[IDLE] Запрос отправлен. Ожидание участников<span class="blink-cursor">_</span></div>
            </div>
        </div>
    </div>

    <!-- Информационная панель приглашения -->
    <div class="invite-panel retro-card">
        <div class="invite-info-side">
            <span class="invite-icon">🔗</span>
            <div>
                <div class="invite-title">БЫСТРОЕ ПРИГЛАШЕНИЕ</div>
                <div class="invite-desc">Скопируйте URL-адрес терминала для удаленных игроков</div>
            </div>
        </div>
        <button type="button" class="btn invite-btn"
                onclick="copyTextToClipboard('@Url.Action("EnterName", "Hub", new { roomCode = Model.RoomCode }, Context.Request.Scheme)', this, 'link')">
            КОПИРОВАТЬ ССЫЛКУ
        </button>
    </div>

    <!-- Кнопки управления комнатой -->
    <div class="control-actions-bar">
        <form asp-controller="Hub" asp-action="LeaveRoom" asp-route-code="@Model.RoomCode" method="post" class="inline-form">
            <button type="submit" class="btn btn-danger-retro">
                [x] ВЫЙТИ
            </button>
        </form>

        <button class="btn btn-refresh-retro" onclick="location.reload();">
            ОБНОВИТЬ
        </button>

        @if (isAmIHost)
        {
            <button id="btn-start-game" class="btn btn-submit-retro">
                [ SUBMIT ] НАЧАТЬ ИГРУ
            </button>
        }
        else
        {
            <button id="btn-toggle-ready" class="btn btn-ready-retro">
                [ READY ] Я ГОТОВ
            </button>
        }
    </div>
</div>

<style>
    /* Базовый контейнер */
    .room-os-container {
        max-width: 900px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 25px;
        width: 100%;
        box-sizing: border-box;
    }

    /* Хелперы выравнивания */
    .align-center {
        align-items: center;
    }

    .wrap-gap {
        flex-wrap: wrap;
        gap: 12px;
    }

    .gap-10 {
        gap: 10px;
    }

    .m-top-4 {
        margin-top: 4px;
    }

    .inline-form {
        display: inline;
        margin: 0;
    }

    /* Кастомные ретро-карточки */
    .retro-card {
        max-width: 100% !important;
        padding: 25px;
        border: 2px solid var(--color-black) !important;
        background: var(--color-white) !important;
        box-shadow: 6px 6px 0px var(--color-black) !important;
        display: flex;
        gap: 25px;
    }

    .floppy-icon-box {
        align-self: center;
        width: 85px;
        height: 85px;
        border: 2px solid var(--color-black);
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: var(--color-gray-light);
        flex-shrink: 0;
        box-shadow: inset 3px 3px 0px rgba(0,0,0,0.15);
    }

    .floppy-emoji {
        font-size: 45px;
    }

    /* Поля данных */
    .retro-spec-list {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-family: 'Courier Prime', monospace;
        font-size: 15px;
    }

    .retro-hr {
        border: none;
        height: 2px;
        background-color: var(--color-black);
        margin-top: 5px;
        margin-bottom: 0;
    }

    .room-main-title {
        margin-bottom: 5px;
    }

    /* Блок кода кликабельный */
    .copy-crypto-box {
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        border: 2px solid var(--color-black);
        box-shadow: 3px 3px 0px var(--color-black);
        background: var(--color-white);
        padding: 6px 14px;
        transition: all 0.05s ease;
        font-weight: bold;
    }

        .copy-crypto-box:hover {
            background: var(--color-gray-light);
            transform: translate(-1px, -1px);
            box-shadow: 4px 4px 0px var(--color-black);
        }

        .copy-crypto-box:active {
            transform: translate(3px, 3px);
            box-shadow: 0px 0px 0px var(--color-black);
        }

    #display-room-code {
        font-family: 'Courier Prime', monospace;
        letter-spacing: 2px;
        font-size: 16px;
        user-select: all;
        margin: 0;
    }

    #code-icon {
        font-size: 14px;
        color: var(--color-gray-medium);
    }

    /* Кастомные баджи данных */
    .host-name-badge {
        color: var(--color-black);
        font-weight: bold;
        background: var(--color-gray-light);
        padding: 4px 10px;
        border: 2px solid var(--color-black);
        box-shadow: 2px 2px 0px rgba(0,0,0,0.1);
    }

    .core-status {
        color: #00ff00 !important;
        border: 2px solid #00ff00 !important;
        padding: 4px 12px !important;
        font-size: 11px;
        font-family: 'Press Start 2P', monospace;
        box-shadow: 3px 3px 0px var(--color-black) !important;
    }

    /* Ретро Селектор */
    .retro-select {
        min-width: 260px;
        padding: 6px 10px;
        font-family: 'Courier Prime', monospace;
        font-size: 14px;
        font-weight: bold;
        border: 2px solid var(--color-black);
        outline: none;
        background: var(--color-white);
        cursor: pointer;
        box-shadow: 3px 3px 0px var(--color-black);
        border-radius: 0;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        background-image: url("data:image/svg+xml;utf8,<svg fill='black' height='24' viewBox='0 0 24 24' width='24' xmlns='http://www.w3.org/2000/svg'><path d='M7 10l5 5 5-5z'/></svg>");
        background-repeat: no-repeat;
        background-position: calc(100% - 5px) center;
    }

        .retro-select:focus {
            background-color: var(--color-gray-light);
        }

    .retro-read-only-value {
        font-weight: bold;
        color: #000;
        background: #fff;
        border: 2px solid var(--color-black);
        padding: 4px 12px;
        box-shadow: 2px 2px 0px var(--color-black);
    }

    .terminal-limits {
        color: var(--color-black);
        font-weight: bold;
    }

    .color-blue {
        color: #0055ff;
        font-weight: bold;
    }

    .color-red {
        color: #ff0055;
        font-weight: bold;
    }

    /* Список подключенных терминалов */
    .terminal-section-title {
        font-size: 13px;
        margin-bottom: 12px;
        font-weight: bold;
        letter-spacing: 1px;
    }

    .retro-list-group {
        border: 2px solid var(--color-black);
        background: var(--color-white);
        padding: 0;
        list-style: none;
        box-shadow: 5px 5px 0px var(--color-black);
        margin: 0;
    }

    .retro-list-item {
        padding: 14px 16px;
        border-bottom: 2px solid var(--color-black);
        font-family: 'Courier Prime', monospace;
        font-size: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .retro-list-item:last-child {
            border-bottom: none;
        }

    .player-info-side {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .terminal-icon {
        font-size: 16px;
    }

    .player-name-text {
        font-family: 'Press Start 2P', monospace;
        font-size: 11px;
        letter-spacing: -0.5px;
    }

    .guest-tag {
        color: var(--color-gray-medium);
        font-size: 11px;
        font-weight: bold;
        margin-left: 4px;
    }

    .player-status-side {
        display: flex;
        gap: 5px;
        align-items: center;
    }

    /* Статусы игроков */
    .ready-status-badge {
        font-family: 'Press Start 2P', monospace;
        font-size: 10px;
        font-weight: bold;
        padding: 4px 8px;
        border: 1px solid transparent;
    }

    .status-ready {
        color: #00aa00;
    }

    .status-not-ready {
        color: #ff0000;
    }

    /* Монитор CRT */
    .monitor-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
    }

    .monitor-title {
        font-size: 11px;
        font-weight: bold;
        color: #222;
        margin: 0;
    }

    .monitor-status-tag {
        font-family: 'Courier Prime', monospace;
        font-size: 11px;
        color: #555;
        font-weight: bold;
    }

    .monitor-crt-screen {
        background-color: #050b05;
        border: 3px solid #222;
        border-radius: 4px;
        box-shadow: 5px 5px 0px var(--color-black);
        padding: 4px;
    }

    #room-console {
        width: 100%;
        height: 150px;
        background-color: #000000;
        color: #33ff33;
        font-family: 'Courier Prime', monospace;
        font-size: 13px;
        padding: 12px;
        overflow-y: auto;
        box-sizing: border-box;
        border: 1px solid #113311;
        text-shadow: 0 0 4px rgba(51, 255, 51, 0.45);
    }

    .sys-log-muted {
        color: #666;
        margin-bottom: 4px;
    }

    .sys-log-accent {
        color: #00ffaa;
        margin-bottom: 4px;
    }

    #console-prompt {
        color: #33ff33;
        display: inline-block;
        margin-top: 4px;
    }

    /* Панель приглашения */
    .invite-panel {
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        flex-wrap: wrap;
    }

    .invite-info-side {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .invite-icon {
        font-size: 24px;
    }

    .invite-title {
        font-family: 'Press Start 2P', monospace;
        font-size: 9px;
        font-weight: bold;
        margin-bottom: 3px;
    }

    .invite-desc {
        font-family: 'Courier Prime', monospace;
        font-size: 13px;
        color: var(--color-gray-dark);
    }

    .invite-btn {
        margin: 0;
        padding: 10px 18px;
        font-size: 10px;
        white-space: nowrap;
    }

    /* Кнопки управления */
    .control-actions-bar {
        margin-top: 5px;
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
    }

        .control-actions-bar .btn {
            padding: 12px 22px;
            white-space: nowrap;
            margin: 0;
        }

    .btn-danger-retro {
        color: #ff0000 !important;
    }

        .btn-danger-retro:hover {
            background-color: #fff0f0 !important;
        }

    .btn-submit-retro {
        background-color: #00aa00 !important;
        color: white !important;
        box-shadow: 4px 4px 0px var(--color-black) !important;
    }

        .btn-submit-retro:hover {
            background-color: #008800 !important;
        }

        .btn-submit-retro:active {
            box-shadow: 0px 0px 0px !important;
            transform: translate(4px, 4px);
        }

    /* Анимация курсора */
    .blink-cursor {
        animation: blink 1s infinite;
    }
    @("@") keyframes blink {
        0%, 49% {
            opacity: 1;
        }

        50%, 100% {
            opacity: 0;
        }
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        window.roomConfig = {
        roomCode: "@Model.RoomCode",
        isHost: "@isAmIHost" === "True",
        currentUserName: "@currentUserName"
        };
    </script>
    <script src="~/js/room-copy.js" asp-append-version="true"></script>
    <script src="~/js/room.js" asp-append-version="true"></script>
}
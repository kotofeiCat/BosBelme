@using System.Security.Claims
@model BosBelme.ViewModels.RoomViewModel
@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var currentUserName = User.FindFirstValue(ClaimTypes.Name);
    bool isAmIHost = Model.Players.Any(p => p.IsHost && p.Id.ToString() == currentUserId);

    var currentPlayer = Model.Players.FirstOrDefault(p => p.Id.ToString() == currentUserId);
    bool isCurrentPlayerReady = currentPlayer?.IsReady ?? false;

    ViewData["Title"] = Model.RoomName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/hub/hub.css">
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
    <div>
        <h1 class="large-text" style="font-size: 24px; margin: 0;">@Model.RoomName</h1>
        <span style="font-size: 12px; color: #8b949e;"><i class="fa-solid fa-wifi"></i> Канал подключен</span>
    </div>
</div>

<div class="hub-container">
    <div class="hub-column">
        <div class="hub-card">
            <div class="hub-card-title"><i class="fa-solid fa-sliders"></i> Параметры Сессии</div>
            <div>
                <span class="other-text" style="display: block; margin-bottom: 8px;">Код комнаты:</span>
                <button class="code-badge-box copy-container" data-copy-text="@Model.RoomCode" title="Нажмите, чтобы скопировать">
                    <span id="display-room-code">@Model.RoomCode</span>
                    <i class="fa-regular fa-copy"></i>
                </button>
            </div>

            <hr style="border-color: #30363d; margin: 4px 0;" />

            <div>
                <label class="other-text" style="display: block; margin-bottom: 8px;">Игра:</label>
                @if (isAmIHost)
                {
                    <input type="hidden" id="game-selector" value="@Model.AvailableGames.FirstOrDefault(g => g.Name == Model.GameName)?.Id" />

                    <button type="button" id="open-game-modal-btn" class="game-select-trigger">
                        <span id="selected-game-title">@Model.GameName</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                }
                else
                {
                    <strong style="color: #f0f6fc; font-size: 15px;">@Model.GameName</strong>
                }
            </div>
        </div>

        <div class="hub-card">
            <div class="hub-card-title"><i class="fa-solid fa-share-nodes"></i> Приглашение</div>
            <p class="other-text" style="margin: 0; font-size: 12px;">Скопируйте ссылку для быстрой отправки друзьям:</p>
            <button class="button-name btn-ghost copy-container" data-copy-text="@Url.Action("EnterName", "Hub", new { roomCode = Model.RoomCode }, Context.Request.Scheme)" style="width: 100%; height: 42px; font-size: 12px;">
                <i class="fa-solid fa-link"></i> Скопировать ссылку
            </button>
        </div>

        <div class="actions-flex-group" style="display: flex; gap: 12px; align-items: stretch;">
            @if (isAmIHost)
            {
                <button id="btn-start-game" class="btn-uiverse-play" style="flex: 2;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                    <span class="play-text">Запустить</span>
                </button>
            }
            else
            {
                <button id="btn-toggle-ready" class="btn-uiverse-play @(isCurrentPlayerReady ? "is-ready" : "")" style="flex: 2;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" /></svg>
                    <span class="play-text" id="ready-btn-text">@(isCurrentPlayerReady ? "ГОТОВ!" : "ГОТОВ")</span>
                </button>
            }
            <form asp-controller="Hub" asp-action="LeaveRoom" asp-route-code="@Model.RoomCode" method="post" style="flex: 1; margin: 0; display: flex;">
                <button type="submit" class="btn-uiverse-play btn-danger-mono">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" /></svg>
                    <span class="play-text">Выйти</span>
                </button>
            </form>
        </div>
    </div>

    <div class="hub-column">
        <div class="hub-card">
            <div class="hub-card-title"><i class="fa-solid fa-users"></i> Игроки (<span id="player-count">@Model.Players.Count</span>)</div>
            <ul id="player-list">
                @foreach (var player in Model.Players)
                {
                    var isHostPill = player.IsHost ? "HOST" : (player.IsReady ? "READY" : "WAITING");
                    <li>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <div class="player-avatar-circle">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div style="display: flex; flex-direction: column;">
                                <strong style="font-size: 14px; color: #f0f6fc;">@player.Name</strong>
                                @if (player.IsGuest)
                                {
                                    <span style="font-size: 10px; color: #8b949e;">Гость</span>
                                }
                            </div>
                        </div>
                        <span class="player-status-badge" style="font-weight: 700; font-size: 10px; color: #8b949e; padding: 4px 8px; background: #21262d; border-radius: var(--radius-sm); border: 1px solid #30363d;">
                            @isHostPill
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        window.roomConfig = {
            roomCode: "@Model.RoomCode",
            isHost: "@isAmIHost" === "True",
            currentUserId: "@currentUserId",
            currentUserName: "@currentUserName",
            isGuest: "@(currentPlayer?.IsGuest ?? false)" === "True",
            isReady: "@isCurrentPlayerReady" === "True"
        };

        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll(".copy-container").forEach(button => {
                button.addEventListener("click", async () => {
                    const textToCopy = button.getAttribute("data-copy-text");
                    if (!textToCopy) return;

                    try {
                        await navigator.clipboard.writeText(textToCopy);
                        const icon = button.querySelector("i");
                        if (icon) {
                            const originalClass = icon.className;
                            icon.className = "fa-solid fa-check";
                            setTimeout(() => icon.className = originalClass, 1500);
                        }
                    } catch (err) {
                        console.error("Ошибка копирования:", err);
                    }
                });
            });

            const gameModal = document.getElementById("game-modal-overlay");

            if (gameModal) {
                document.body.appendChild(gameModal);
            }

            const openGameModalBtn = document.getElementById("open-game-modal-btn");
            const closeGameModalBtn = document.getElementById("close-game-modal-btn");
            const gameSelectorInput = document.getElementById("game-selector");
            const selectedGameTitle = document.getElementById("selected-game-title");

            if (openGameModalBtn) {
                openGameModalBtn.addEventListener("click", () => {
                    if (gameModal) gameModal.classList.add("show");
                });
            }

            const closeModal = () => {
                if (gameModal) gameModal.classList.remove("show");
            };

            if (closeGameModalBtn) {
                closeGameModalBtn.addEventListener("click", closeModal);
            }

            if (gameModal) {
                gameModal.addEventListener("click", (e) => {
                    if (e.target === gameModal) closeModal();
                });
            }

            document.querySelectorAll(".game-card-item").forEach(card => {
                card.addEventListener("click", () => {
                    const gameId = card.getAttribute("data-game-id");
                    const gameName = card.getAttribute("data-game-name");

                    document.querySelectorAll(".game-card-item").forEach(c => c.classList.remove("active"));
                    card.classList.add("active");

                    if (selectedGameTitle) selectedGameTitle.textContent = gameName;

                    if (gameSelectorInput) {
                        gameSelectorInput.value = gameId;
                        gameSelectorInput.dispatchEvent(new Event("change", { bubbles: true }));
                    }

                    closeModal();
                });
            });
        });
    </script>
    <script src="~/js/room.js" asp-append-version="true"></script>
}

<div id="game-modal-overlay" class="game-modal-overlay">
    <div class="game-modal">
        <div class="game-modal-header">
            <span class="game-modal-title"><i class="fa-solid fa-gamepad"></i> Выберите игру</span>
            <button type="button" id="close-game-modal-btn" class="game-modal-close">&times;</button>
        </div>
        <div class="game-modal-body">
            @foreach (var game in Model.AvailableGames)
            {
                bool isSelected = game.Name == Model.GameName;
                <div class="game-card-item @(isSelected ? "active" : "")" data-game-id="@game.Id" data-game-name="@game.Name">
                    <div class="game-card-info">
                        <div class="game-card-top">
                            <h4 class="game-card-title">@game.Name</h4>
                            <span class="game-players-badge">
                                <i class="fa-solid fa-users"></i>
                            </span>
                        </div>
                        <p class="game-card-desc">
                            @(string.IsNullOrWhiteSpace(game.Description) ? "Описание пока не добавлено." : game.Description)
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
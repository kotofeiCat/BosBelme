@model BosBelme.ViewModels.JoinRoomCodeViewModel

@{
    ViewData["Title"] = "Хаб";
}

<h2 class="large-text">Подключение по коду</h2>
<hr/>

<p class="other-text">Для входа в чужую операционную комнату введите ее уникальный 6-значный идентификатор.</p>

<form asp-controller="Hub" asp-action="JoinRoom" method="post">

    <div class="input-group">
        <label asp-for="RoomCode">Код Доступа (Код Комнаты):</label>
        <input asp-for="RoomCode" placeholder="RM1234" style="text-transform: uppercase;" autocomplete="off" />
        <span asp-validation-for="RoomCode" style="color: red; font-family: monospace; font-size: 11px; margin-top: 5px;"></span>
    </div>

    <div class="btn-container">
        <button class="btn" type="submit">
            [->] Далее
        </button>
        <a class="small-link" asp-controller="Hub" asp-action="Index">Отмена</a>
    </div>
</form>
@model BosBelme.ViewModels.JoinRoomViewModel
@{
    ViewData["Title"] = "Подключение";
}

@section Scripts {
    <script>
        document.querySelector('.window')?.classList.add('window-auth');
    </script>
}

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
{
    <div id="validation-toast-container" class="toast-container-fixed">
        <div class="toast-item toast-animate-in">
            <div class="error-alert-toast">
                <div style="display: flex; align-items: center;">
                    <div class="error-icon-box">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z"></path>
                        </svg>
                    </div>
                    <div class="error-body">
                        <p class="error-title">Ошибка авторизации</p>
                        <p class="error-desc">
                            @foreach (var modelState in ViewData.ModelState.Values)
                            {
                                @foreach (var error in modelState.Errors)
                                {
                                    <span>@error.ErrorMessage</span>
                                }
                            }
                        </p>
                    </div>
                </div>
                <button type="button" class="toast-close-btn" onclick="this.closest('.toast-item').remove()">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <script>
        setTimeout(() => {
            const container = document.getElementById('validation-toast-container');
            if (container) {
                const toast = container.querySelector('.toast-item');
                if (toast) {
                    toast.classList.remove('toast-animate-in');
                    toast.classList.add('toast-animate-out');
                    setTimeout(() => container.remove(), 400); 
                }
            }
        }, 5000);
    </script>
}


<div style="display: flex; flex-direction: column; align-items: center; text-align: center; padding: 10px 0;">
    <div style="width: 50px; height: 50px; border-radius: 50%; background: #21262d; border: 1px solid #30363d; display: flex; align-items: center; justify-content: center; color: #f0f6fc; font-size: 20px; margin-bottom: 16px;">
        <i class="fa-solid fa-right-to-bracket"></i>
    </div>

    <h2 class="auth-title">Войти в комнату</h2>
    <p class="auth-subtitle">Введите 10-значный код комнаты, полученный от организатора</p>

    <form asp-controller="Hub" asp-action="JoinRoom" method="post" style="width: 100%;">
        <div class="input-group">
            <input asp-for="RoomCode"
                   class="input"
                   required
                   placeholder=" "
                   autocomplete="off"
                   style="font-family: var(--font-mono); letter-spacing: 2px; text-align: left; font-size: 16px; font-weight: 700; padding-left: 12px;" />
            <label class="user-label" asp-for="RoomCode">Код комнаты (напр. Rm34Xq)</label>
            <span asp-validation-for="RoomCode" style="color: #f85149; font-size: 11px; margin-top: 4px; display: block;"></span>
        </div>


        <div style="display: flex; flex-direction: column; gap: 20px; margin-top: 12px; margin-bottom: 24px; width: 100%;">
            <button class="btn white" type="submit" style="width: 100%;">
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
                <span>Войти</span>
            </button>

            <a class="btn" asp-controller="Hub" asp-action="Index" style="width: 100%;">
                <span>Назад</span>
            </a>
        </div>
    </form>
</div>
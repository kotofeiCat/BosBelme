@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<h1 class="large-text" style="color: var(--color-danger)">Произошла ошибка</h1>
<p class="other-text">При обработке вашего запроса возникла непредвиденная системная ошибка.</p>
<hr />

@if (Model.ShowRequestId)
{
    <div class="info-card" style="margin-bottom: 20px;">
        <div>
            <span class="info-label">Request ID:</span>
            <code class="info-value" style="font-family: monospace;">@Model.RequestId</code>
        </div>
    </div>
}

<div class="btn-container">
    <a asp-controller="Home" asp-action="Index" class="button-with-icon">
        <span>На главную</span>
    </a>
</div>
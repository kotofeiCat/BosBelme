<header class="menu-bar">
    <div class="menu-left">
        <span class="menu-item logo-icon">⚂</span>
        <span class="menu-item" onclick="location.href='@Url.Action("Index", "Home")'"><b>RoomBox</b></span>
        <a class="menu-item" asp-controller="Home" asp-action="Help">Помощь</a>
    </div>
    <div class="menu-right">
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <a class="menu-item" asp-controller="Account" asp-action="Profile">👤 Профиль</a>
            <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                <button type="submit" class="menu-item logout-btn" style="background:none; border:none; font-family:inherit; font-size:inherit; font-weight:inherit; cursor:pointer;">Выйти</button>
            </form>
        }
        else
        {
            <a class="menu-item" asp-controller="Account" asp-action="Login">Войти</a>
            <a class="menu-item" asp-controller="Account" asp-action="Register">Регистрация</a>
        }
        <span class="menu-item" id="system-clock">12:00 PM</span>
    </div>
</header>

<script>
    function updateClock() {
        const now = new Date();
        let hours = now.getHours();
        const minutes = now.getMinutes().toString().padStart(2, '0');
        const ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12 || 12;
        const clockEl = document.getElementById('system-clock');
        if(clockEl) clockEl.textContent = `${hours}:${minutes} ${ampm}`;
    }
    setInterval(updateClock, 1000);
    updateClock();
</script>